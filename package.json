{
  "name": "venti",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck -w @venti/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "npm run start -w @venti/db",
    "db:migrate": "npm run migrate -w @venti/db",
    "db:generate": "npm run generate -w @venti/db",
    "dev:api": "npm run dev -w @venti/api",
    "dev:worker": "npm run worker -w @venti/api",
    "build:vercel": "node scripts/build-vercel.mjs",
    "dev:web": "npm run dev -w @venti/web"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@17.12.0-beta.19": true,
    "@embedded-postgres/linux-x64@17.12.0-beta.19": true
  }
}

# ─── VENTI API ───
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Rol de la aplicación (sujeto a RLS). Nunca usar el rol dueño aquí.
DATABASE_URL=postgres://venti_app:CAMBIAR@localhost:54320/venti
DATABASE_POOL_MAX=20
# Rol dueño (superusuario o BYPASSRLS): sólo para migraciones.
DATABASE_OWNER_URL=postgres://postgres:CAMBIAR@localhost:54320/venti

# Firma Ed25519 de QRs. Generar con: npm run keys -w @venti/api
QR_SIGNING_PRIVATE_KEY=

SESSION_TTL_HOURS=720
HOLD_TTL_MINUTES=10
# true en producción (HTTPS). false sólo en desarrollo local por HTTP.
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000
# true si la API corre detrás de un balanceador/CDN que setea X-Forwarded-For.
TRUST_PROXY=false

# ─── Postgres embebido de desarrollo (npm run db:start) ───
VENTI_DEV_PG_PORT=54320
VENTI_DEV_PG_OWNER_PASSWORD=venti_dev_owner
VENTI_DEV_PG_APP_PASSWORD=venti_dev_app_password_local
